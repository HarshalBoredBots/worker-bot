# ═══════════════════════════════════════════════════════════════
# Worker Bot — Environment Variables
# Copy this to .env for local development (never commit .env).
# In Render: set these in the Environment tab of your service.
#
# REQUIRED variables must be set — the service exits at startup
# with a clear error if any are missing.
# ═══════════════════════════════════════════════════════════════

# ── REQUIRED: Telegram API credentials ───────────────────────
API_ID=
API_HASH=

# ── REQUIRED: This Worker's Bot Token (unique per worker) ─────
BOT_TOKEN=

# ── REQUIRED: Worker Control Group ───────────────────────────
WORKER_CONTROL_GROUP_ID=

# ── REQUIRED: Worker Output Channel ──────────────────────────
WORKER_OUTPUT_CHANNEL_ID=

# ── REQUIRED: MongoDB connection ─────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
DB_NAME=DistributedRenameBot

# ── Worker Identity ───────────────────────────────────────────
# Unique across all workers: worker_01, worker_02, …
WORKER_ID=worker_01

# Max concurrent jobs — clamped 1–10
WORKER_CONCURRENCY=3

WORKER_VERSION=1.0.0

# ── Heartbeat (seconds) — clamped 15–300 ─────────────────────
HEARTBEAT_INTERVAL=30
WORKER_OFFLINE_TIMEOUT=120

# ── Optional: ImgBB thumbnail upload ─────────────────────────
# Leave empty to skip thumbnail generation (non-fatal)
IMGBB_API_KEY=

# ── Health check port — clamped 1024–65535 ────────────────────
PORT=8015

# ── Graceful shutdown — clamped 10–300 s ─────────────────────
SHUTDOWN_GRACE_SECONDS=60

# ── Resource limits ───────────────────────────────────────────
MAX_DOWNLOAD_RETRIES=4
MAX_UPLOAD_RETRIES=4
FFMPEG_TIMEOUT=600
HTTP_TIMEOUT=30
MAX_QUEUE_SIZE=50
